    "tier_priors": { "great": 0.1, "solid": 0.25, "complication": 0.2, "minor": 0.2, "major": 0.1, "catastrophe": 0.05 },
    "effect_scales": { "group_mood": 1, "group_loyalty": 1, "player_stat": 1, "treasury": 1, "player_money": 1, "support": 1 },
