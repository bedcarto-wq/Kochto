    "magnitude_model": { "base": 1.0, "top_prob_weight": 2.0, "jitter": 0.5 },
    "drift": { "bound": 1, "plaus_penalty": 0.02 },
    "patch_rules": { "keyword_map": { "плохо": {"flip_polarity": true}, "сильно": {"magnitude_scale": 1.5}, "мягко": {"magnitude_scale": 0.6}, "нейтрально": {"tone_shift": 0.0} }, "default_ops": {} },
    "thresholds": { "min_plausibility": 0.3, "ambiguity_gap": 0.1 },
